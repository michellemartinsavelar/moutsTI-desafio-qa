{
  "name": "moutsti-desafio-qa",
  "version": "1.0.0",
  "description": "Suíte de testes automatizados E2E e de API com Cypress para a aplicação ServeRest",
  "private": true,
  "type": "module",
  "author": "Michelle Avelar",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**/*.cy.js\""
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.2.1"
  }
}
